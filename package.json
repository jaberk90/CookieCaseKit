    "react": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@google-cloud/firestore": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@azure/cosmos": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@azure/communication-email": {
      "optional": true
    }
  }
}
