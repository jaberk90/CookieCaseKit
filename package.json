        "default": "./dist/cloud/dynamodb.cjs"
      }
    },
    "./cosmos": {
      "import": {
        "types": "./dist/cloud/cosmos.d.ts",
        "default": "./dist/cloud/cosmos.js"
      },
      "require": {
        "types": "./dist/cloud/cosmos.d.cts",
        "default": "./dist/cloud/cosmos.cjs"
      }
    },
    "./s3": {
      "import": {
        "types": "./dist/cloud/s3.d.ts",
        "default": "./dist/cloud/s3.js"
      },
      "require": {
        "types": "./dist/cloud/s3.d.cts",
        "default": "./dist/cloud/s3.cjs"
      }
    },
    "./gcs": {
      "import": {
        "types": "./dist/cloud/gcs.d.ts",
        "default": "./dist/cloud/gcs.js"
      },
      "require": {
        "types": "./dist/cloud/gcs.d.cts",
        "default": "./dist/cloud/gcs.cjs"
      }
    },
    "./blob": {
      "import": {
        "types": "./dist/cloud/blob.d.ts",
        "default": "./dist/cloud/blob.js"
      },
      "require": {
        "types": "./dist/cloud/blob.d.cts",
        "default": "./dist/cloud/blob.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/cloud/auth.d.ts",
        "default": "./dist/cloud/auth.js"
      },
      "require": {
        "types": "./dist/cloud/auth.d.cts",
        "default": "./dist/cloud/auth.cjs"
      }
    },
    "./email": {
      "import": {
        "types": "./dist/cloud/email.d.ts",
        "default": "./dist/cloud/email.js"
      },
      "require": {
        "types": "./dist/cloud/email.d.cts",
        "default": "./dist/cloud/email.cjs"
      }
    },
    "./ses": {
      "import": {
        "types": "./dist/cloud/ses.d.ts",
        "default": "./dist/cloud/ses.js"
      },
      "require": {
        "types": "./dist/cloud/ses.d.cts",
        "default": "./dist/cloud/ses.cjs"
      }
    },
    "./azure-email": {
      "import": {
        "types": "./dist/cloud/azure-email.d.ts",
        "default": "./dist/cloud/azure-email.js"
      },
      "require": {
        "types": "./dist/cloud/azure-email.d.cts",
        "default": "./dist/cloud/azure-email.cjs"
      }
    }
  },
  "files": [
    "dist",
    "public",
    "LICENSE",
    "README.md",
    "docs",
    "examples/contact-us.ts",
    "examples/express.ts",
    "examples/react-page.tsx",
    "examples/cloud"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "keywords": [
    "ticketing",
    "helpdesk",
    "case-management",
    "express",
    "support"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-react-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx examples/demo.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:ui": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:react": "tsx examples/react-server.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.31",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1142.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sesv2": "^3.1142.0",
    "@aws-sdk/lib-dynamodb": "^3.1142.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^8.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaberk90/CookieCaseKit.git"
  },
  "homepage": "https://github.com/jaberk90/CookieCaseKit#readme",
  "bugs": {
    "url": "https://github.com/jaberk90/CookieCaseKit/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1142.0",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sesv2": "^3.1142.0",
    "@aws-sdk/lib-dynamodb": "^3.1142.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^8.2.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "react": "^18.2.0 || ^19.0.0"
  },
