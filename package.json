{
  "name": "cookiecasekit",
  "version": "1.0.2",
  "description": "Embeddable case management for Node.js. Bring your authentication; configure the rest.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react.css": "./dist/react.css",
    "./cloud": {
      "import": {
        "types": "./dist/cloud/index.d.ts",
        "default": "./dist/cloud/index.js"
      },
      "require": {
        "types": "./dist/cloud/index.d.cts",
        "default": "./dist/cloud/index.cjs"
      }
    },
    "./firestore": {
      "import": {
        "types": "./dist/cloud/firestore.d.ts",
        "default": "./dist/cloud/firestore.js"
      },
      "require": {
        "types": "./dist/cloud/firestore.d.cts",
        "default": "./dist/cloud/firestore.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/cloud/postgres.d.ts",
        "default": "./dist/cloud/postgres.js"
      },
      "require": {
        "types": "./dist/cloud/postgres.d.cts",
        "default": "./dist/cloud/postgres.cjs"
      }
    },
    "./dynamodb": {
      "import": {
